
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>سر صغير لنافيا تشان 🎀</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap');

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Cairo', sans-serif;
    background: linear-gradient(135deg, #fff0f5, #fce4ec, #fff7fa);
    color: #704254;
    min-height: 100vh;
    overflow-x: hidden;
}

.container {
    width: 90%;
    max-width: 480px;
    margin: 0 auto;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 35px 0;
}

.card {
    width: 100%;
    background: rgba(255,255,255,0.88);
    padding: 30px 22px;
    border-radius: 28px;
    text-align: center;
    box-shadow: 0 12px 40px rgba(190, 110, 140, 0.13);
    border: 1px solid #fff;
    animation: appear 0.7s ease;
}

@keyframes appear {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

.emoji {
    font-size: 55px;
    margin-bottom: 15px;
}

h1 {
    font-size: 27px;
    margin-bottom: 12px;
    color: #c45b83;
}

h2 {
    font-size: 21px;
    margin-bottom: 15px;
    color: #c45b83;
}

p {
    font-size: 15px;
    line-height: 2;
    margin-bottom: 20px;
}

button {
    font-family: inherit;
    cursor: pointer;
    border: none;
    transition: 0.25s;
}

.main-btn {
    background: linear-gradient(135deg, #e98bab, #c85d86);
    color: white;
    padding: 13px 28px;
    border-radius: 30px;
    font-size: 16px;
    font-weight: bold;
    box-shadow: 0 5px 15px #e9b1c5;
}

.main-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px #e9b1c5;
}

.hidden {
    display: none !important;
}

.progress {
    width: 100%;
    height: 8px;
    background: #f6e1e9;
    border-radius: 20px;
    margin: 20px 0;
    overflow: hidden;
}

.progress-bar {
    width: 0%;
    height: 100%;
    background: #dc7d9e;
    transition: 0.4s;
    border-radius: 20px;
}

.options {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 20px 0;
}

.option {
    background: #fff5f8;
    border: 2px solid #f4d5e0;
    padding: 13px;
    border-radius: 15px;
    color: #805166;
    font-size: 14px;
    font-weight: 600;
}

.option:hover {
    background: #ffe7ef;
}

.option.selected {
    background: #f9dce7;
    border-color: #d36f94;
    color: #a23f68;
}

.option:disabled {
    cursor: default;
    opacity: 1;
}

.question-number {
    color: #d27a99;
    font-size: 13px;
    font-weight: bold;
}

.poem {
    background: #fff5f8;
    padding: 20px 12px;
    border-radius: 18px;
    line-height: 2.4;
    margin: 20px 0;
    font-size: 15px;
}

.gift {
    font-size: 95px;
    cursor: pointer;
    display: inline-block;
    transition: 0.5s;
    animation: bounce 2s infinite;
}

@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}

.gift:hover {
    transform: scale(1.15);
}

.message {
    background: #fff5f8;
    border: 1px solid #f4d4e0;
    border-radius: 20px;
    padding: 20px;
    margin-top: 20px;
    line-height: 2.3;
    animation: appear 0.8s ease;
}

.message p {
    margin-bottom: 12px;
}

.footer {
    font-size: 12px;
    color: #bd8a9e;
    margin-top: 25px;
}

.heart {
    position: fixed;
    top: -30px;
    pointer-events: none;
    animation: fall linear forwards;
    z-index: 10;
}

@keyframes fall {
    to {
        transform: translateY(110vh) rotate(360deg);
        opacity: 0;
    }
}
</style>
</head>

<body>

<div class="container">

<!-- صفحة الترحيب -->
<section class="card" id="welcome">
    <div class="emoji">🎀💗</div>
    <h1>أهلًا نافيا تشان</h1>
    <p>
        عندي ليكي حاجة صغيرة ومميزة،
        لكن قبل ما توصلي لها عندي خمس أسئلة بسيطة ليكي.
        <br>
        مستعدة تكتشفي المفاجأة؟
    </p>
    <button class="main-btn" onclick="startQuiz()">
        افتحي مفاجأتك 💗
    </button>
    <div class="footer">صُنعت بحب واهتمام خصيصًا ليكي ✨</div>
</section>

<!-- الأسئلة -->
<section class="card hidden" id="quiz">
    <div class="emoji">🌷</div>
    <span class="question-number" id="number">السؤال 1 من 5</span>
    <div class="progress">
        <div class="progress-bar" id="bar"></div>
    </div>

    <h2 id="question"></h2>
    <p id="description">اختاري الإجابة الأقرب لقلبك 💕</p>

    <div class="options" id="options"></div>

    <button class="main-btn" id="next" onclick="nextQuestion()" disabled>
        السؤال التالي
    </button>
</section>

<!-- القصيدة -->
<section class="card hidden" id="poem">
    <div class="emoji">🌸</div>
    <h1>قبل المفاجأة...</h1>
    <p>وصلتي للنهاية! لكن فيه كلمات صغيرة حابب أهديها ليكي.</p>

    <div class="poem">
        هناك أشخاص يأتون كضوء الصباح،<br>
        فيجعلون الأيام أكثر جمالًا وارتياح،<br>
        وليس كل حب يحتاج إلى كلمات غرام،<br>
        فبعض المحبة أسمى من كل الكلام،<br>
        قد تصبح الأرواح عائلة دون قرابة،<br>
        وتظل المودة أجمل هدية مستجابة،<br>
        فكوني دائمًا سعيدة ومطمئنة،<br>
        فأنتِ ذكرى جميلة في صفحة من حياتنا. 💗
    </div>

    <button class="main-btn" onclick="showGift()">
        اكتشفي هديتك 🎁
    </button>
</section>

<!-- صندوق الهدية -->
<section class="card hidden" id="gift">
    <div class="emoji">💌</div>
    <h1>وصلتي لهديتك!</h1>
    <p>فيه رسالة صغيرة مستنياكي جوا الصندوق.</p>

    <div class="gift" id="giftIcon" onclick="openGift()">🎁</div>
    <p>اضغطي على الصندوق لفتح رسالتك 💗</p>

    <div class="message hidden" id="message">
        <h2>إلى نافيا تشان 💗</h2>

        <p>
            حابب أقولك حاجة يمكن مكنتش عرفت أعبر عنها
            بالشكل الكافي قبل كده.
        </p>

        <p>
            أنا بحبك جدًا، لكن حبي ليكي مش حب رومانسي،
            أنا بحبك زي أختي الكبيرة بالظبط،
            وبعتبرك شخص مميز وغالي عندي.
        </p>

        <p>
            وجودك في حياتي حاجة جميلة، وبتمنى ليكي
            السعادة والنجاح وتحقيق كل أحلامك.
            وأتمنى تفضلي دايمًا بخير، وتفضلي محتفظة
            بابتسامتك الجميلة.
        </p>

        <p>
            شكرًا لأنك شخص مميز في حياتي،
            وأتمنى إن علاقتنا تفضل مليانة مودة
            واحترام وذكريات جميلة.
        </p>

        <h2>بحبك يا أختي الكبيرة 💗</h2>

        <p>من أخوكي الصغير، كايزر 🌷</p>
    </div>

    <div class="footer">نهاية المفاجأة، وبداية ذكرى جميلة ✨</div>
</section>

</div>

<script>

const questions = [
    {
        q: "إيه معنى الحب بالنسبالك؟",
        a: [
            "الاهتمام والتقدير 💗",
            "الثقة والاحترام 🤍",
            "الوجود وقت الحاجة 🌷",
            "كل ما سبق ✨"
        ]
    },
    {
        q: "إيه أكتر حاجة ممكن تخلي يومك سعيد؟",
        a: [
            "رسالة جميلة من شخص عزيز 💌",
            "قضاء وقت مع العائلة 🏡",
            "تحقيق حاجة كنت بتمناها 🌸",
            "مفاجأة غير متوقعة 🎁"
        ]
    },
    {
        q: "إيه الأهم بالنسبالك في أي علاقة؟",
        a: [
            "الصدق والصراحة 🤍",
            "الاهتمام المتبادل 💕",
            "الاحترام والثقة 🌷",
            "كلهم مهمين"
        ]
    },
    {
        q: "هل ممكن شخص غريب عنك بالدم يبقى زي فرد من عيلتك؟",
        a: [
            "أكيد، لو بينا محبة واهتمام 💗",
            "طبعًا، العائلة مش بالدم بس 🌸",
            "ده بيعتمد على المواقف ✨",
            "أيوه، وبشدة"
        ]
    },
    {
        q: "إيه أكتر حاجة تتمني الناس تفهمها عن مشاعرك؟",
        a: [
            "إني بحس بالتفاصيل الصغيرة 🤍",
            "إني بقدر الاهتمام جدًا 💌",
            "إني محتاجة الصدق والتفاهم 🌷",
            "إني مش دايمًا بعرف أعبر عن اللي جوايا 💗"
        ]
    }
];

let current = 0;
let selected = false;

function hideAll() {
    document.querySelectorAll('.card').forEach(card => {
        card.classList.add('hidden');
    });
}

function startQuiz() {
    hideAll();
    document.getElementById('quiz').classList.remove('hidden');
    loadQuestion();
}

function loadQuestion() {
    selected = false;

    document.getElementById('number').textContent =
        `السؤال ${current + 1} من 5`;

    document.getElementById('bar').style.width =
        `${(current / 5) * 100}%`;

    document.getElementById('question').textContent =
        questions[current].q;

    document.getElementById('next').disabled = true;

    document.getElementById('next').textContent =
        current === 4 ? "إنهاء الأسئلة 💗" : "السؤال التالي";

    const options = document.getElementById('options');
    options.innerHTML = "";

    questions[current].a.forEach(answer => {
        const btn = document.createElement('button');
        btn.className = 'option';
        btn.textContent = answer;

        btn.onclick = () => {
            if (selected) return;

            selected = true;

            document.querySelectorAll('.option').forEach(b => {
                b.classList.remove('selected');
                b.disabled = true;
            });

            btn.classList.add('selected');

            document.getElementById('next').disabled = false;
        };

        options.appendChild(btn);
    });
}

function nextQuestion() {
    if (!selected) return;

    current++;

    if (current < 5) {
        loadQuestion();
    } else {
        hideAll();
        document.getElementById('poem').classList.remove('hidden');
        document.getElementById('bar').style.width = "100%";
    }
}

function showGift() {
    hideAll();
    document.getElementById('gift').classList.remove('hidden');
    createHearts();
}

function openGift() {
    const message = document.getElementById('message');

    if (!message.classList.contains('hidden')) return;

    message.classList.remove('hidden');

    document.getElementById('giftIcon').textContent = "💝";

    createHearts();
}

function createHearts() {
    const symbols = ["💗", "💕", "🌸", "✨", "💖"];

    for (let i = 0; i < 20; i++) {
        const heart = document.createElement('div');

        heart.className = 'heart';
        heart.textContent =
            symbols[Math.floor(Math.random() * symbols.length)];

        heart.style.left = Math.random() * 100 + "vw";
        heart.style.animationDuration =
            (3 + Math.random() * 4) + "s";

        heart.style.fontSize =
            (15 + Math.random() * 18) + "px";

        document.body.appendChild(heart);

        setTimeout(() => heart.remove(), 7000);
    }
}

</script>

</body>
</html>
